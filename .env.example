# ---- Required ----
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
JWT_SECRET=replace-with-64-random-characters
SITE_URL=https://your-site.netlify.app

# ---- Sign-in ----
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ---- AI assistant (console.anthropic.com). Without it the chat gives simple built-in answers ----
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Email (resend.com): reset links, care team alerts, student reply notices ----
RESEND_API_KEY=
MAIL_FROM=WellBridge <no-reply@yourdomain.com>

# ---- SMS (termii.com), optional ----
TERMII_API_KEY=
TERMII_SENDER=WellBridge

# ---- Care team alerts: who is told when a student is flagged (comma separated) ----
CARE_NOTIFY_EMAIL=
CARE_NOTIFY_PHONE=

# ---- Emergency escalation: the duty officer who gets the student's name, email and phone ----
ESCALATION_EMAIL=
ESCALATION_PHONE=

# ---- Shown in the app ----
CONTACT_EMAIL=
SECURITY_PHONE=
CRISIS_PHONE=
COUNSELING_PHONE=
